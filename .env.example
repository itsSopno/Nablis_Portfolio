# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_db

# Security & Authentication
JWT_SECRET=portfolio_jwt_secret_key_change_in_production_123456
JWT_EXPIRES_IN=7d

# Default Admin Credentials (for seed script)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=admin123456

# Email Notification Configuration (Nodemailer - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
